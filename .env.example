# Gopang IT Solution — environment variables (names only, no real values).
# On cPanel the recommended approach is api/config.local.php, but every value
# below is also overridable via a real environment variable (getenv()).

# --- Database (MySQL) ---
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# --- Admin login ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
APP_SECRET=

# --- Dynamic Apply module ---
# Max PDF/DOC/DOCX upload size in bytes (default 8388608 = 8 MB).
APPLY_MAX_FILE_SIZE=8388608
# Maximum submissions from the same source/opportunity during the window.
APPLY_RATE_LIMIT=5
APPLY_RATE_WINDOW=3600

# --- Solutions community module (Q&A) ---
# Publish guest questions/comments immediately (true) or hold as pending (false).
SOLUTIONS_AUTO_PUBLISH=false
# Require CAPTCHA on guest forms. Only enforced when a Turnstile secret is also set.
SOLUTIONS_REQUIRE_CAPTCHA=true
# Max attachment size in bytes (default 8388608 = 8 MB).
SOLUTIONS_MAX_UPLOAD_SIZE=
# Comma-separated allowed upload extensions (default: .pdf,.doc,.docx,.png,.jpg,.jpeg,.gif,.txt,.log).
SOLUTIONS_ALLOWED_FILE_TYPES=
# Max guest submissions per IP within SOLUTIONS_RATE_LIMIT_WINDOW seconds.
SOLUTIONS_QUESTION_RATE_LIMIT=5
SOLUTIONS_COMMENT_RATE_LIMIT=15
SOLUTIONS_RATE_LIMIT_WINDOW=3600
# Seed a few demo questions on first run (dev only). Leave false in production.
SEED_SAMPLE_SOLUTIONS=false

# --- Cloudflare Turnstile (leave empty to disable CAPTCHA entirely) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- NewsAPI (technology news) ---
# Server-side only. Never exposed to the browser, never commit the real key.
# Get a free key at https://newsapi.org. Leave NEWS_API_KEY empty here — set the
# real key on the server (config.local.php or a real env var).
NEWS_API_KEY=
NEWS_API_BASE_URL=https://newsapi.org/v2
NEWS_API_CATEGORY=technology
NEWS_API_LANGUAGE=en
NEWS_API_PAGE_SIZE=20
NEWS_API_CACHE_MINUTES=30
