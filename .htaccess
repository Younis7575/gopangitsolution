# Gopang IT Solution — clean URL routing for descriptively named HTML files.
# Existing public URLs stay unchanged after replacing generic index.html files.

Options -MultiViews
DirectoryIndex home.html index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^$ home.html [L]
    RewriteRule ^about/?$ about/about.html [L]

    # Blog & Insights — original long-form content (blog/index.html + blog/<slug>/index.html)
    RewriteRule ^blog/?$ blog/index.html [L]
    RewriteRule ^blog/([a-z0-9-]+)/?$ blog/$1/index.html [L]

    # Portfolio. NOTE: /projects is claimed further down by the Apply flow
    # (^(jobs|internships|partnerships|projects|project-based-hiring)/?...), so the
    # portfolio page is served at /portfolio. Do not move it back to /projects
    # without also changing the Apply routing and the /apply-project 301.
    # The rule sits above every other rule and the Apply rule below explicitly
    # refuses "portfolio", so /portfolio can never fall through to the Apply
    # page again (it did in production on 2026-10-04: /portfolio returned
    # apply/opportunities.html and the page then 404'd on /api/portfolio).
    RewriteRule ^portfolio/?$ projects/projects.html [L]

    # Policy / transparency pages (each lives at <slug>/index.html)
    RewriteRule ^terms-of-service/?$ terms-of-service/index.html [L]
    RewriteRule ^cookie-policy/?$ cookie-policy/index.html [L]
    RewriteRule ^disclaimer/?$ disclaimer/index.html [L]
    RewriteRule ^editorial-policy/?$ editorial-policy/index.html [L]

    RewriteRule ^admin-applications/?$ admin-applications/applications.html [L]
    RewriteRule ^admin-applicants/?$ admin-applicants/index.html [L]
    RewriteRule ^admin-apply/?$ admin-apply/index.html [L]
    RewriteRule ^admin-analytics/?$ admin-analytics/index.html [L]
    RewriteRule ^admin-dashboard/?$ admin-dashboard/dashboard.html [L]
    RewriteRule ^admin-jobs/?$ admin-jobs/jobs.html [L]
    RewriteRule ^admin-login/?$ admin-login/login.html [L]
    RewriteRule ^admin-news/?$ admin-news/news-management.html [L]
    RewriteRule ^admin-project-hiring/?$ admin-project-hiring/project-hiring-requests.html [L]
    RewriteRule ^admin-projects/?$ admin-projects/projects-management.html [L]
    RewriteRule ^admin-submissions/?$ admin-submissions/submissions.html [L]
    RewriteRule ^admin-solutions/?$ admin-solutions/solutions-management.html [L]
    # Student Project Hub admin (Overview, Consultations, Project Requests,
    # Showcase, Settings) — same auth model as the rest of the panel.
    RewriteRule ^admin-student-projects/?$ admin-student-projects/overview.html [L]
    RewriteRule ^admin-student-projects/(overview|consultations|projects|showcase|settings|availability)/?$ admin-student-projects/$1.html [L]
    RewriteRule ^apply-job/?$ jobs [R=301,L]
    RewriteRule ^apply-partner/?$ partnerships [R=301,L]
    RewriteRule ^apply-project/?$ projects [R=301,L]
    # The negative lookahead keeps the portfolio URL out of the Apply flow even
    # if this rule is ever moved above the portfolio rule above.
    RewriteRule ^(?!portfolio/?$)(jobs|internships|partnerships|projects|project-based-hiring)/?([^/]*)/?$ apply/opportunities.html [L]
    RewriteRule ^contact/?$ contact/contact.html [L]
    RewriteRule ^faq/?$ faq/faq.html [L]
    RewriteRule ^index-2/?$ index-2/home-variant-two.html [L]
    RewriteRule ^index-3/?$ index-3/home-variant-three.html [L]
    RewriteRule ^news/?$ news/news.html [L]
    RewriteRule ^solutions/?$ solutions/solutions.html [L]
    RewriteRule ^solutions/ask/?$ solutions/ask.html [L]
    RewriteRule ^solutions/create/?$ solutions/ask.html [L]
    RewriteRule ^solutions/([^/]+)/?$ solutions/detail.html [L]
    RewriteRule ^news-detail/?$ news-detail/news-detail.html [L]
    RewriteRule ^news-details/?$ news-details/news-details.html [L]
    RewriteRule ^news-external/?$ news-external/index.html [L]
    RewriteRule ^pricing/?$ pricing/pricing.html [L]
    RewriteRule ^privacy-policy/?$ privacy-policy/privacy-policy.html [L]
    RewriteRule ^project-bid-detail/?$ project-bid-detail/project-bid-detail.html [L]
    RewriteRule ^submit-project-bid/?$ submit-project-bid/submit-project-bid.html [L]
    RewriteRule ^project-details/?$ project-details/project-details.html [L]
    RewriteRule ^services/?$ services/services.html [L]
    RewriteRule ^services-details/?$ services-details/service-details.html [L]

    # Student Project Hub — free consultation + Final Year Project requests.
    # The confirmation page reads ?ref= from the query string, which Apache
    # preserves automatically.
    RewriteRule ^student-projects/?$ student-projects/index.html [L]
    RewriteRule ^student-projects/consultation/?$ student-projects/consultation.html [L]
    RewriteRule ^student-projects/project-request/?$ student-projects/project-request.html [L]
    # SEO cluster pages — each one covers a genuinely different search intent.
    RewriteRule ^student-projects/(mobile-app|web-development|flutter|ai-ml|ui-ux)/?$ student-projects/$1.html [L]
    RewriteRule ^student-projects/admin/?$ admin-student-projects/overview.html [L]
    RewriteRule ^student-projects/admin/consultations/?$ admin-student-projects/consultations.html [L]
    RewriteRule ^student-projects/admin/projects/?$ admin-student-projects/projects.html [L]
    RewriteRule ^student-projects/admin/showcase/?$ admin-student-projects/showcase.html [L]
    RewriteRule ^student-projects/admin/settings/?$ admin-student-projects/settings.html [L]
    RewriteRule ^student-projects/admin/availability/?$ admin-student-projects/settings.html [L]

    # Service detail pages (each lives at <slug>/index.html)
    RewriteRule ^mobile-app-development/?$ mobile-app-development/index.html [L]
    RewriteRule ^web-development/?$ web-development/index.html [L]
    RewriteRule ^ui-ux-design/?$ ui-ux-design/index.html [L]
    RewriteRule ^custom-software-development/?$ custom-software-development/index.html [L]
    RewriteRule ^ecommerce-development/?$ ecommerce-development/index.html [L]
    RewriteRule ^backend-api-development/?$ backend-api-development/index.html [L]
    RewriteRule ^cloud-devops/?$ cloud-devops/index.html [L]
    RewriteRule ^ai-machine-learning/?$ ai-machine-learning/index.html [L]
    RewriteRule ^quality-assurance-testing/?$ quality-assurance-testing/index.html [L]
    RewriteRule ^maintenance-support/?$ maintenance-support/index.html [L]
    RewriteRule ^it-consulting/?$ it-consulting/index.html [L]
    RewriteRule ^submission-status/?$ submission-status/submission-status.html [L]
    RewriteRule ^team/?$ team/team.html [L]
    RewriteRule ^team-details/?$ team-details/team-details.html [L]
</IfModule>
